@echo off
setlocal
title Unnamed Creature Shelter
set "SHELTER_ROOT=%~dp0"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; $public=[IO.Path]::GetFullPath((Join-Path $env:SHELTER_ROOT 'app')); if (!(Test-Path (Join-Path $public 'index.html'))) {throw 'Extract the entire ZIP before starting. Missing app/index.html.'}; $listener=[Net.Sockets.TcpListener]::new([Net.IPAddress]::Loopback,0); $listener.Start(); $url='http://127.0.0.1:'+$listener.LocalEndpoint.Port+'/'; Write-Host 'Unnamed Creature Shelter' -ForegroundColor Green; Write-Host ('Open in Chrome or Edge: '+$url); Write-Host 'Keep this window open. Close this window to stop.'; Write-Host 'Click the camera button in the page and allow camera access.'; Start-Process $url; try { while ($true) { $client=$listener.AcceptTcpClient(); try { $stream=$client.GetStream(); $stream.ReadTimeout=5000; $stream.WriteTimeout=10000; $reader=[IO.StreamReader]::new($stream,[Text.Encoding]::ASCII,$false,1024,$true); $first=$reader.ReadLine(); if (!$first) {continue}; while ($reader.ReadLine()) {}; $parts=$first.Split(' '); $method=$parts[0]; $relative=[Uri]::UnescapeDataString($parts[1].Split('?')[0]).TrimStart('/'); if (!$relative) {$relative='index.html'}; $file=[IO.Path]::GetFullPath((Join-Path $public $relative)); $mime='application/octet-stream'; $status='200 OK'; if ($method -ne 'GET' -and $method -ne 'HEAD') {$status='405 Method Not Allowed';$data=[Text.Encoding]::UTF8.GetBytes('Method not allowed')} elseif (!$file.StartsWith($public+[IO.Path]::DirectorySeparatorChar,[StringComparison]::OrdinalIgnoreCase)) {$status='403 Forbidden';$data=[Text.Encoding]::UTF8.GetBytes('Forbidden')} elseif (![IO.File]::Exists($file)) {$status='404 Not Found';$data=[Text.Encoding]::UTF8.GetBytes('Not found')} else { $data=[IO.File]::ReadAllBytes($file); $types=@{'.html'='text/html; charset=utf-8';'.js'='text/javascript';'.css'='text/css';'.wasm'='application/wasm';'.svg'='image/svg+xml';'.png'='image/png';'.json'='application/json'}; $ext=[IO.Path]::GetExtension($file).ToLowerInvariant(); if ($types.ContainsKey($ext)) {$mime=$types[$ext]}; }; $header='HTTP/1.1 '+$status+[char]13+[char]10+'Content-Type: '+$mime+[char]13+[char]10+'Content-Length: '+$data.Length+[char]13+[char]10+'Connection: close'+[char]13+[char]10+'X-Content-Type-Options: nosniff'+[char]13+[char]10+[char]13+[char]10; $bytes=[Text.Encoding]::ASCII.GetBytes($header); $stream.Write($bytes,0,$bytes.Length); if ($method -ne 'HEAD') {$stream.Write($data,0,$data.Length)}; $stream.Flush(); } catch {Write-Host ('Request ended: '+$_.Exception.Message)} finally {$client.Close()}; } } finally {$listener.Stop()};"
if errorlevel 1 echo Startup failed. Read the message above.
pause
